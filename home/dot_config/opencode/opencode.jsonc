{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@warp-dot-dev/opencode-warp"],
  "permissions": [
    {
      "action": "read",
      "resource": "~/.config/opencode/get-shit-done/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/get-shit-done/*",
      "effect": "allow",
    },
  ],
  "default_agent": "build",
  "mcp": {
    "tolaria": {
      "command": [
        "/Users/lecoqjacob/.local/share/mise/shims/node",
        "/Applications/Tolaria.app/Contents/Resources/mcp-server/index.js",
      ],
      "environment": {
        "WS_UI_PORT": "9711",
      },
      "type": "local",
    },
  },
}
