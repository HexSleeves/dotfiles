{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow",
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow",
    },
  },
  "default_agent": "build",
  "mcp": {
    "tolaria": {
      "command": [
        "/Users/lecoqjacob/.local/share/mise/shims/node",
        "/Applications/Tolaria.app/Contents/Resources/mcp-server/index.js",
      ],
      "environment": {
        "WS_UI_PORT": "9711",
      },
      "type": "local",
    },
  },
}
